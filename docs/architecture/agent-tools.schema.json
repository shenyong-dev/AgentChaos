{
  "version": "booking-registry-v1",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "update_booking_request",
        "description": "提取当前用户明确给出的字段，每字段必须提供原文source_quotes；缺失不猜测。",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "date": {
              "anyOf": [
                {
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "当地日期YYYY-MM-DD；相对日期按服务端参考时钟解析。",
              "title": "Date"
            },
            "start_time": {
              "anyOf": [
                {
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "当地钟表时间HH:MM，例如14:00；不含日期、秒或时区。",
              "title": "Start Time"
            },
            "end_time": {
              "anyOf": [
                {
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "当地钟表时间HH:MM，例如15:00；不含日期、秒或时区。",
              "title": "End Time"
            },
            "duration_minutes": {
              "anyOf": [
                {
                  "maximum": 120,
                  "minimum": 30,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "仅当用户明确说时长时填写；已给起止时间就分别填写start_time和end_time。",
              "title": "Duration Minutes"
            },
            "attendees": {
              "anyOf": [
                {
                  "maximum": 2147483647,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Attendees"
            },
            "room_code": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Room Code"
            },
            "source_quotes": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "每个本次填写的字段都要有同名键，对应当前用户输入的原文片段；保留的旧字段不要重复填写。",
              "title": "Source Quotes",
              "type": "object"
            },
            "clear_fields": {
              "items": {
                "type": "string"
              },
              "maxItems": 6,
              "title": "Clear Fields",
              "type": "array"
            }
          },
          "title": "FieldPatch",
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "retrieve_rules",
        "description": "检索冻结的实验规则条款，返回来源/修订/有效条件；无依据明确返回。",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "query": {
              "maxLength": 1000,
              "minLength": 1,
              "title": "Query",
              "type": "string"
            }
          },
          "required": [
            "query"
          ],
          "title": "RuleQuery",
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "query_availability",
        "description": "只读查询当前结构化需求的场地空闲；必须与已提取字段一致。",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "start_at": {
              "format": "date-time",
              "title": "Start At",
              "type": "string"
            },
            "end_at": {
              "format": "date-time",
              "title": "End At",
              "type": "string"
            },
            "attendees": {
              "maximum": 2147483647,
              "minimum": 1,
              "title": "Attendees",
              "type": "integer"
            },
            "room_code": {
              "anyOf": [
                {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Room Code"
            }
          },
          "required": [
            "start_at",
            "end_at",
            "attendees"
          ],
          "title": "AvailabilityQuery",
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "preview_booking",
        "description": "生成完整待确认草稿并撤销本会话旧稿；不创建预约。",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "start_at": {
              "format": "date-time",
              "title": "Start At",
              "type": "string"
            },
            "end_at": {
              "format": "date-time",
              "title": "End At",
              "type": "string"
            },
            "attendees": {
              "maximum": 2147483647,
              "minimum": 1,
              "title": "Attendees",
              "type": "integer"
            },
            "room_code": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$",
              "title": "Room Code",
              "type": "string"
            }
          },
          "required": [
            "start_at",
            "end_at",
            "attendees",
            "room_code"
          ],
          "title": "PreviewBooking",
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "confirm_booking",
        "description": "合法用户确认后提交当前草稿，复用原幂等标识；模型不能授权自己。",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "draft_id": {
              "format": "uuid",
              "title": "Draft Id",
              "type": "string"
            },
            "draft_hash": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Draft Hash",
              "type": "string"
            },
            "idempotency_key": {
              "format": "uuid",
              "title": "Idempotency Key",
              "type": "string"
            }
          },
          "required": [
            "draft_id",
            "draft_hash",
            "idempotency_key"
          ],
          "title": "ConfirmBookingToolInput",
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "lookup_booking_by_request",
        "description": "按原幂等标识查证当前身份的预约事实；暂未查到不证明失败。",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "idempotency_key": {
              "format": "uuid",
              "title": "Idempotency Key",
              "type": "string"
            }
          },
          "required": [
            "idempotency_key"
          ],
          "title": "RequestLookup",
          "type": "object"
        }
      }
    }
  ]
}
