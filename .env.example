# Copy with: python scripts/init_env.py
# The script generates local database/Redis/demo passwords and never prints them.
APP_ENV=development
API_PORT=8000
FRONTEND_PORT=5173
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=agentchaos
MYSQL_USER=agentchaos
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Local demo application accounts; never commit a real value.
DEMO_SEED_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_DB=0
REDIS_PASSWORD=
DEPENDENCY_TIMEOUT_SECONDS=2

# Backend only. Never add VITE_* secrets. T01 does not call the model.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-flash
CASEGEN_MODEL=deepseek-flash
JUDGE_MODEL=deepseek-flash
AGENT_THINKING=disabled
CASEGEN_THINKING=disabled
JUDGE_THINKING=disabled
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=0
AGENT_MAX_OUTPUT_TOKENS=1024
CASEGEN_MAX_OUTPUT_TOKENS=2048
JUDGE_MAX_OUTPUT_TOKENS=1024
# Zero means no authorized budget, never unlimited.
ALLOW_PAID_MODEL_CALLS=false
MODEL_BUDGET_AUTHORIZATION_ID=
AGENT_BUDGET_USD=0
CASEGEN_BUDGET_USD=0
JUDGE_BUDGET_USD=0
RUN_CONCURRENCY=1
