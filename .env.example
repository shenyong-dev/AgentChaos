# Copy with: python scripts/init_env.py
# The script generates local database/Redis/demo passwords and never prints them.
APP_ENV=development
API_PORT=8000
FRONTEND_PORT=5173
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=agentchaos
MYSQL_USER=agentchaos
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Local demo application accounts; never commit a real value.
DEMO_SEED_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_DB=0
REDIS_PASSWORD=
DEPENDENCY_TIMEOUT_SECONDS=2

# Backend only. Never add VITE_* secrets. T01 does not call the model.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-flash
CASEGEN_MODEL=deepseek-flash
JUDGE_MODEL=deepseek-flash
AGENT_THINKING=disabled
CASEGEN_THINKING=disabled
JUDGE_THINKING=disabled
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=0
AGENT_MAX_OUTPUT_TOKENS=1024
CASEGEN_MAX_OUTPUT_TOKENS=2048
JUDGE_MAX_OUTPUT_TOKENS=1024
# Zero means no authorized budget, never unlimited.
ALLOW_PAID_MODEL_CALLS=false
MODEL_BUDGET_AUTHORIZATION_ID=
AGENT_BUDGET_USD=0
CASEGEN_BUDGET_USD=0
CASEGEN_ALLOW_PAID_MODEL_CALLS=false
CASEGEN_BUDGET_AUTHORIZATION_ID=
CASEGEN_BUDGET_UNLIMITED=false
JUDGE_ALLOW_PAID_MODEL_CALLS=false
JUDGE_BUDGET_AUTHORIZATION_ID=
JUDGE_BUDGET_UNLIMITED=false
JUDGE_BUDGET_USD=0
RUN_CONCURRENCY=1

# T05 has a separate approval and persistent ledger. Never reset it on restart.
EXECUTOR_ALLOW_PAID_MODEL_CALLS=false
EXECUTOR_BUDGET_AUTHORIZATION_ID=
EXECUTOR_AGENT_BUDGET_USD=0
EXECUTOR_AGENT_BUDGET_UNLIMITED=false
EXECUTOR_QUEUE=agentchaos
EXECUTOR_NAMESPACE=ac:t05
EXECUTOR_LEASE_SECONDS=45
SSE_MAX_SECONDS=30
SSE_SEND_TIMEOUT_SECONDS=5
SSE_MAX_BACKLOG=1000
